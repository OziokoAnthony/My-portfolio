# Copy this file to `.env` and adjust the values before deploying.

# Password used to sign in at /admin. REQUIRED in production.
ADMIN_PASSWORD=change-me-to-something-strong

# Secret used to sign the session cookie. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Port the API / production server listens on.
PORT=4000

# Set to production when deploying (enables secure cookies — needs HTTPS).
NODE_ENV=development

# Largest upload allowed, in megabytes.
MAX_UPLOAD_MB=8
